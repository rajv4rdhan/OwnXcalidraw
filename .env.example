# Private Excalidraw template — environment variables.
# Copy to `.env.local` for local development and set the same values in the
# Vercel dashboard (Project → Settings → Environment Variables).

# ---- Auth (server-side only) ----------------------------------------------
# The single fixed password required to open the board.
APP_PASSWORD=changeme
# Random 32-byte base64url string used to sign the session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-random-string

# ---- Supabase (server-side only) ------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Secret key (Supabase → Settings → API). NEVER expose this to the browser.
SUPABASE_SECRET_KEY=
# Private storage bucket name (default: board-files).
SUPABASE_BUCKET=board-files
