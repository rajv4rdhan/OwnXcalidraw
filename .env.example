# Private Excalidraw template — environment variables.
#
# Layout:
#   - This file documents the SECRETS. Copy it to `.env.local` for local dev
#     and set the same values in Vercel (Project → Settings → Environment
#     Variables) for production.
#   - Public build config (VITE_APP_*) lives in `.env.development` (local) and
#     `.env.production` (build). Those files are committed and already work.

# ---- Auth (server-side only) ----------------------------------------------
# The single fixed password required to open the board.
APP_PASSWORD=changeme
# Random 32-byte base64url string used to sign the session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-random-string

# ---- Supabase (server-side only) ------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Secret key (Supabase → Settings → API). NEVER expose this to the browser.
SUPABASE_SECRET_KEY=
# Private storage bucket name (default: board-files).
SUPABASE_BUCKET=board-files

# ---- File cleanup (server-side only) --------------------------------------
# How long an unreferenced image is kept before deletion (minutes).
# Protects undo and in-flight uploads. Set to 0 to delete immediately.
FILE_GC_GRACE_MINUTES=5
